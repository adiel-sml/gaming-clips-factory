# Copier en .env puis adapter. Toutes les variables sont optionnelles.

# --- Sécurité (OBLIGATOIRE dès que l'API est accessible sur Internet)
# Jeton exigé pour chaque appel à l'API (le site le demande à la première visite).
# Générer : openssl rand -hex 32
GCF_API_TOKEN=
# Sites autorisés à appeler l'API (ex. ton URL Vercel), séparés par des virgules
GCF_CORS_ORIGINS=http://localhost:3000

# --- LLM (optionnel) : affine le scoring, les hooks, titres et captions.
# Sans clé, le système fonctionne entièrement avec les règles.
ANTHROPIC_API_KEY=

# --- Base de données : vide = SQLite (data/gcf.db). Exemple PostgreSQL :
# DATABASE_URL=postgresql+psycopg://gcf:gcf@localhost:5432/gcf
DATABASE_URL=

# --- Dossiers (par défaut : ./data et ./output à la racine du projet)
# GCF_DATA_DIR=/chemin/vers/data
# GCF_OUTPUT_DIR=/chemin/vers/output

# --- Surcharge de n'importe quelle clé de config.yaml : GCF__SECTION__CLE=valeur
# GCF__TRANSCRIPTION__MODEL=small
# GCF__VIDEO__MAX_CLIP_DURATION=45
# GCF__OUTPUT__FPS=60

# --- Hugging Face (téléchargement plus rapide des modèles Whisper)
# HF_TOKEN=

# --- Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
